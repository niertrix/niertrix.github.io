---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
const { title = `${site.name} | AI & Data Engineering Portfolio`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  jobTitle: 'AI Engineering student and data analyst', url: site.url, image: new URL('/images/profile-640.webp', Astro.site).href,
  sameAs: [site.github, site.linkedin], address: { '@type': 'PostalAddress', addressLocality: 'Mansoura', addressCountry: 'EG' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#F1EBDD">
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/icon.ico?v=4" sizes="32x32">
  <link rel="icon" href="/icon.svg?v=4" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/images/profile-640.webp', Astro.site).href}>
  <meta name="twitter:card" content="summary">
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>
</head>
<body>
  <canvas id="bg" aria-hidden="true"></canvas>
  <div class="page" id="top">
    <Nav />
    <main><slot /></main>
    <footer class="foot">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="#top">Back to top ↑</a>
    </footer>
  </div>
  <script>import '../scripts/main.js';</script>
</body>
</html>
