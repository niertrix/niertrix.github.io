---
import Section from './Section.astro';
import { education, skills, languages } from '../data/site';
---
<Section id="about" cmd="man abdulrahman">
  <div class="term man" data-man tabindex="0" role="group" aria-label="Manual pages for abdulrahman">
    <div class="term__bar">~/man/abdulrahman</div>
    <div class="term__body">
      <div class="man__head"><span>ABDULRAHMAN(1)</span><span>Personal Manual</span><span>ABDULRAHMAN(1)</span></div>

      <div class="man__pages" data-pages>
        <div class="man__page" data-page>
          <h3>Name</h3>
          <div class="man__body"><p><code>abdulrahman</code> – data analyst growing into an AI engineer</p></div>

          <h3>Synopsis</h3>
          <div class="man__body"><p><code>abdulrahman [--study ai-engineering] [--learn machine-learning] [--build data-pipelines]</code></p></div>

          <h3>Description</h3>
          <div class="man__body">
            <p>I study Artificial Intelligence Engineering at Mansoura University and hold the Google Data Analyst Specialist certificate through the Digital Egypt Pioneers Initiative.</p>
            <p>I like the whole path from raw data to a result someone can use: cleaning, modeling, and building the reports and dashboards on top. Right now I’m pushing from analytics into applied machine learning.</p>
          </div>


          <h3>Languages</h3>
          <div class="man__body"><ul class="langs">{languages.map(([n, l]) => <li><span class="langs__name">{n}</span><span class="langs__level">{l}</span></li>)}</ul></div>
        </div>

        <div class="man__page" data-page>
          <h3>Toolkit</h3>
          <div class="man__body skills">
            {skills.map(([g, items]) => (
              <div><h4>{g}</h4><ul class="tags">{(items as string[]).map((i) => <li>{i}</li>)}</ul></div>
            ))}
          </div>
        </div>

        <div class="man__page" data-page>
          <h3>Education</h3>
          <div class="man__body">
            <ol class="edu">
              {education.map(([when, what, where]) => (
                <li><time>{when}</time><strong>{what}</strong><span>{where}</span></li>
              ))}
            </ol>
          </div>
        </div>
      </div>

      <div class="man__nav" data-nav hidden>
        <button class="btn btn--solid man__btn" type="button" data-prev>← Prev</button>
        <div class="man__status">
          <span data-status aria-live="polite">Manual page abdulrahman(1) page 1/3</span>
          <span class="man__hint">Click the page, then use ← → or space and b.</span>
        </div>
        <button class="btn btn--solid man__btn" type="button" data-next>Next →</button>
      </div>
    </div>
  </div>
</Section>

<script>
  const man = document.querySelector('[data-man]') as HTMLElement | null;
  if (man) {
    const pages = Array.from(man.querySelectorAll<HTMLElement>('[data-page]'));
    const box = man.querySelector('[data-pages]') as HTMLElement;
    const nav = man.querySelector('[data-nav]') as HTMLElement;
    const prev = man.querySelector('[data-prev]') as HTMLButtonElement;
    const next = man.querySelector('[data-next]') as HTMLButtonElement;
    const status = man.querySelector('[data-status]') as HTMLElement;
    let i = 0;

    function size() {
      box.style.minHeight = '';
      let tallest = 0;
      pages.forEach((p) => { p.hidden = false; tallest = Math.max(tallest, p.offsetHeight); });
      pages.forEach((p, k) => { p.hidden = k !== i; });
      box.style.minHeight = tallest + 'px';
    }
    function show(n: number) {
      i = Math.min(pages.length - 1, Math.max(0, n));
      pages.forEach((p, k) => { p.hidden = k !== i; });
      prev.disabled = i === 0;
      next.disabled = i === pages.length - 1;
      status.textContent = `Manual page abdulrahman(1) page ${i + 1}/${pages.length}`;
    }

    nav.hidden = false;
    show(0);
    size();
    window.addEventListener('resize', size);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(size);

    prev.addEventListener('click', () => show(i - 1));
    next.addEventListener('click', () => show(i + 1));
    man.addEventListener('keydown', (e) => {
      if (e.target !== man) return;
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); show(i + 1); }
      if (e.key === 'ArrowLeft' || e.key === 'b' || e.key === 'PageUp') { e.preventDefault(); show(i - 1); }
    });
  }
</script>
